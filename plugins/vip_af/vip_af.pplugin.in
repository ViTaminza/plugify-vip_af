{
	"$schema": "https://raw.githubusercontent.com/untrustedmodders/plugify/refs/heads/main/schemas/plugin.schema.json",
	"version": "${VIP_AF_VERSION}",
	"name": "vip_af",
	"description": "[VIP] Anti Flash: a player_blind hook clears the flash duration of a VIP whose 'antiflash' group value is > 0, with the original's four modes (teammate / self / both / any). Ported from the Pisex VIP core module VIP_AntiFlash (vip_af). Requires the vip core.",
	"author": "Pisex, ported to Plugify",
	"website": "https://github.com/untrustedmodders/plugify",
	"license": "GPL-3.0",
	"entry": "bin/vip_af",
	"platforms": [],
	"language": "cpp",
	"dependencies": [
		{
			"name": "s2sdk",
			"constraints": ">=2.18.2"
		},
		{
			"name": "vip",
			"constraints": ">=1.0.0"
		},
		{
			"name": "hudmenu",
			"constraints": ">=1.0.0",
			"optional": true
		}
	]
}
